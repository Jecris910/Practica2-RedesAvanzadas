# Credenciales y configuracion privada
.env
.env.*
!.env.example

# Terraform: estado y archivos locales
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Variables privadas
*.tfvars
*.tfvars.json

# Configuracion publica de los entornos
!/environments/dev/terraform.tfvars
!/environments/prod/terraform.tfvars

# Sobrescrituras locales
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Archivos generados
**/generated/

# Python
__pycache__/
*.pyc
.venv/

# Archivos temporales y editores
*.bak
*.save
*.swp
*.swo
*.log
.DS_Store
.vscode/

# Archivos de entrega
*.zip
*.rar
