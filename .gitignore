
# PRACTICA 2 - ARCHIVOS QUE NO SE SUBEN A GITHUB

# Credenciales y configuraciones privadas.
.env
.env.*
**/.env
**/.env.*

# Estado de Terraform y archivos locales.
**/.terraform/
*.tfstate
