override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Python.
__pycache__/
*.pyc
.venv/

# Archivos temporales.
*.swp
*.swo
*.log
.DS_Store
.vscode/

# Archivos comprimidos.
*.rar
